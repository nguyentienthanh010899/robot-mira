# Copy to .env. Never use VITE_ for secrets. Restart backend after edits.
PORT=3001
# Local-first: cloud disabled even when keys are present.
ALLOW_CLOUD_AI=false
# Cloudflare uses its AI binding; no Gemini or Groq credentials are required.
# Set a model you already downloaded locally to enable Ollama.
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: set 0 if Metal/MLX/GGUF GPU inference fails; blank uses runtime default.
OLLAMA_NUM_GPU=

# Optional smaller local model for Fast mode, must be pulled separately.
OLLAMA_FAST_MODEL=qwen3.5:2b-q4_K_M
LOCAL_TTS_URL=http://127.0.0.1:3002

# Optional CPU thread limit, benchmark on your hardware.
OLLAMA_NUM_THREAD=
